# Copy to `.env` and adjust if you want to override the dev-default MCP API keys
# used by docker-compose. These protect each service's MCP endpoint (ports
# 8101/8102/8103) — see design.md section 3.3. They are NOT used to protect the
# REST APIs, which remain open within the container network.

MEETING_MCP_API_KEY=dev-meeting-mcp-key
LOCATION_MCP_API_KEY=dev-location-mcp-key
NOMNOM_MCP_API_KEY=dev-nomnom-mcp-key
