# Copy to `.env` and adjust if you want to override the dev-default MCP API keys
# used by docker-compose. These protect each service's MCP endpoint (ports
# 8101/8102/8103) — see design.md section 3.3. They are NOT used to protect the
# REST APIs, which remain open within the container network.

MEETING_MCP_API_KEY=dev-meeting-mcp-key
LOCATION_MCP_API_KEY=dev-location-mcp-key
NOMNOM_MCP_API_KEY=dev-nomnom-mcp-key

# ---------------------------------------------------------------------------
# Agent team (see design_akgents.md). Required once the team runs; the keys
# above are reused as the agents' MCP bearer tokens.
# ---------------------------------------------------------------------------

OPENAI_API_KEY=
AGENT_MODEL=gpt-6-luna

# MCP endpoints as seen BY THE AGENT TEAM. The defaults below are Docker Compose
# service names. Running the team on the host instead? Use localhost:810x.
MEETING_MCP_URL=http://meeting-service:8101/mcp
LOCATION_MCP_URL=http://location-service:8102/mcp
NOMNOM_MCP_URL=http://nomnom-service:8103/mcp

# ---------------------------------------------------------------------------
# Who is asking (design_auth.md). AUTH=demo lets you log in as any person the
# meeting service knows, without a password; AUTH=off makes everybody anonymous.
# AUTH_SECRET signs the session cookie - left empty, sessions end at every
# server restart. ADMIN_EMAILS see every team. API_KEYS is how the console logs
# in: comma-separated key=email pairs; the console asks for the key. Choose your
# own keys - nothing here is a real one.
# ---------------------------------------------------------------------------

AUTH=demo
AUTH_SECRET=
ADMIN_EMAILS=
API_KEYS=

# ---------------------------------------------------------------------------
# The Akgentic console (console/README.md). The framework's own Angular client,
# built straight from upstream at a pinned commit - a FULL sha, because the git
# build context refuses a short one. Its backend is set in console/config.json,
# not here: that file is mounted over the image, so it needs no rebuild.
# ---------------------------------------------------------------------------

AKGENTIC_CONSOLE_REF=e82b549f3873f417af615d878bb85c5333e2f831
